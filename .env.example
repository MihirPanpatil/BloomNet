# Basic secrets
# Generate with: openssl rand -hex 32
KERNEL_JWT_SECRET=

# Choose your own; at least 8 characters for the password (openssl rand -base64 24)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Tailscale configuration (optional - for secure networking)
# Get your auth key from https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=tskey-...

# Generate these tokens (instructions follow). For now leave blank placeholders and fill them
before starting datanodes.
PHOTOS_PARENT_TOKEN=
PHOTOS_CHILD_A_TOKEN=
PHOTOS_CHILD_B_TOKEN=
RESEARCH_PARENT_TOKEN=
RESEARCH_CHILD_A_TOKEN=
RESEARCH_CHILD_B_TOKEN=
CLIENTS_PARENT_TOKEN=
CLIENTS_CHILD_A_TOKEN=
CLIENTS_CHILD_B_TOKEN=

PORTAL_TOKEN=


